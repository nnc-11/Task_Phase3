name: M12 external audit watchdog

on:
  schedule:
    - cron: "*/15 * * * *"
  workflow_dispatch:

permissions:
  id-token: write
  contents: read
  issues: write

concurrency:
  group: m12-external-audit-watchdog
  cancel-in-progress: false

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.M12_WATCHDOG_ROLE_ARN }}
          aws-region: ap-southeast-1
      - name: Verify audit foundation
        env:
          TRAIL_NAME: ${{ vars.M12_TRAIL_NAME }}
          AUDIT_BUCKET_NAME: ${{ vars.M12_AUDIT_BUCKET_NAME }}
          EKS_CLUSTER_NAME: ${{ vars.M12_EKS_CLUSTER_NAME }}
          PRIMARY_RULE_NAMES: ${{ vars.M12_PRIMARY_RULE_NAMES }}
          GLOBAL_RULE_NAMES: ${{ vars.M12_GLOBAL_RULE_NAMES }}
          PRIMARY_RULE_PATTERNS_JSON: ${{ vars.M12_PRIMARY_RULE_PATTERNS_JSON }}
          GLOBAL_RULE_PATTERNS_JSON: ${{ vars.M12_GLOBAL_RULE_PATTERNS_JSON }}
          PRIMARY_ROUTER_ARN: ${{ vars.M12_PRIMARY_ROUTER_ARN }}
          GLOBAL_ROUTER_ARN: ${{ vars.M12_GLOBAL_ROUTER_ARN }}
          HEARTBEAT_RULE_NAME: ${{ vars.M12_HEARTBEAT_RULE_NAME }}
          HEARTBEAT_FUNCTION_ARN: ${{ vars.M12_HEARTBEAT_FUNCTION_ARN }}
          HEARTBEAT_ALARM_NAMES: ${{ vars.M12_HEARTBEAT_ALARM_NAMES }}
          PRIMARY_TOPIC_ARN: ${{ vars.M12_PRIMARY_TOPIC_ARN }}
          GLOBAL_TOPIC_ARN: ${{ vars.M12_GLOBAL_TOPIC_ARN }}
          EXPECTED_SUBSCRIPTION_ENDPOINTS: ${{ vars.M12_EXPECTED_SUBSCRIPTION_ENDPOINTS }}
        run: bash .github/scripts/m12-watchdog.sh
      - name: Raise or update external incident signal
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          title="M12 external audit watchdog failed"
          issue="$(gh issue list --state open --search "${title} in:title" --json number --jq '.[0].number // empty')"
          if [[ -n "$issue" ]]; then
            gh issue comment "$issue" --body "Watchdog failed again: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
          else
            gh issue create --title "$title" --body "Independent audit check failed: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
          fi
